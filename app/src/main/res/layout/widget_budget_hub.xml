<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hub_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_widget_card">

    <!-- Top Header: Logo, Brand Name & Update Time / Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_leaf_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Leaf"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leaf Financial"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_brand"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <TextView
            android:id="@+id/hub_widget_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/hub_widget_btn_refresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Refresh Widget"
            android:padding="2dp" />
    </LinearLayout>

    <!-- Hero Balance Box -->
    <LinearLayout
        android:id="@+id/hub_widget_hero_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_widget_stat_pill"
        android:padding="12dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL BALANCE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_secondary"
                android:letterSpacing="0.08" />

            <ImageView
                android:id="@+id/hub_widget_btn_toggle_visibility"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_visibility"
                android:contentDescription="Toggle Balance Visibility"
                android:padding="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hub_widget_total_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0.00"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/hub_widget_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Income: +₹0.00"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_income_text"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/hub_widget_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spent: -₹0.00"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_expense_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- Monthly Budget Progress Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Monthly Budget Progress"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary" />

            <TextView
                android:id="@+id/hub_widget_budget_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0 / ₹0"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/hub_widget_budget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/widget_btn_expense_bg"
            android:progressBackgroundTint="@color/widget_pill_bg"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Flexible spacer frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Quick Hub Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/hub_widget_btn_add_expense"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="+ Expense"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:background="@drawable/bg_widget_btn_expense"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/hub_widget_btn_split"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Split Bill"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:gravity="center"
            android:background="@drawable/bg_widget_stat_pill"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/hub_widget_btn_planning"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Planning"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:gravity="center"
            android:background="@drawable/bg_widget_stat_pill" />
    </LinearLayout>
</LinearLayout>

