<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_widget_card">

    <!-- Top Header: Official Logo / Branding, Month Pill, Eye Toggle & Refresh Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_leaf_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Leaf"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leaf"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_brand"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_month_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This Month"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_pill_text"
            android:background="@drawable/bg_widget_stat_pill"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/widget_btn_toggle_visibility"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_visibility"
            android:contentDescription="Toggle Balance Visibility"
            android:padding="2dp"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Refresh Widget"
            android:padding="2dp" />
    </LinearLayout>

    <!-- Middle Hero: Current Balance Primary Metric -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CURRENT BALANCE"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_secondary"
        android:letterSpacing="0.08"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/widget_total_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0.00"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="1dp" />

    <!-- Budget Progress Line (Consolidated from Budget Widgets) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_budget_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monthly Budget"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/widget_budget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/widget_text_brand"
            android:progressBackgroundTint="@color/widget_pill_bg"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Monthly Summary Row: Income & Expense -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <!-- Monthly Income -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INCOME"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_secondary"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/widget_monthly_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₹0.00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_income_text"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Monthly Expenses -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPENSES"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_secondary"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/widget_monthly_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-₹0.00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_expense_text"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Spacer: RemoteViews-compatible FrameLayout -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom: Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:weightSum="2">

        <Button
            android:id="@+id/widget_btn_add_expense"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="+ Expense"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_widget_btn_expense"
            android:textColor="@color/widget_btn_text"
            android:stateListAnimator="@null"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/widget_btn_add_income"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="+ Income"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_widget_btn_income"
            android:textColor="@color/widget_btn_text"
            android:stateListAnimator="@null"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
